# Dependencies
/node_modules/
/.pnpm-store/

# Angular build output and cache
/dist/
/out-tsc/
/.angular/

# Test output
/coverage/
/.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files
.env
.env.*
!.env.example

# TypeScript incremental build information
*.tsbuildinfo

# IDE and editor state
/.idea/
/.history/
/.settings/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Keep shared VS Code project configuration, ignore local additions
/.vscode/*
!/.vscode/extensions.json
!/.vscode/launch.json
!/.vscode/settings.json
!/.vscode/tasks.json

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
/.cache/
/.tmp/
